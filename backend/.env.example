# Copy to .env and fill in real values for local dev. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://keel:keel@localhost:5432/keel
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=replace-with-a-random-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-random-fernet-key

CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development

# Plaid sandbox credentials — https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Must be a publicly reachable HTTPS URL for Plaid to deliver webhooks to (e.g. via ngrok in
# local dev). Leave blank to skip webhook registration.
PLAID_WEBHOOK_URL=
