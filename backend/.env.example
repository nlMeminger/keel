# Copy to .env and fill in real values for local dev. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://moneyapp:moneyapp@localhost:5432/moneyapp
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=replace-with-a-random-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-random-fernet-key

CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development
